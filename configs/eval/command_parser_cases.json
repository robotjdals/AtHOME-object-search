{
  "version": "0.1",
  "purpose": "Held-out evaluation of natural-language command -> targets (scripts/eval_command_parser.py). Must not overlap the few-shot examples in athome/inference/command_parser.py.",
  "rule": "expected: one entry per target in order; each entry lists accepted names (first = preferred). In-vocabulary objects accept only the category name; ambiguous words list reasonable alternatives. Empty expected = not a search request.",
  "cases": [
    {"kind": "in_vocabulary", "command": "핸드폰 어디 있는지 좀 찾아줘", "expected": [["phone"]]},
    {"kind": "in_vocabulary", "command": "티비 리모콘 찾아줘", "expected": [["remote control"]]},
